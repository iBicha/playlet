' DISABLE_CACHE will disable all caching for all requests.
' Only use this for debugging purposes.
#const DISABLE_CACHE = false
' NETWORK_THROTTLE will add a random delay to all requests to simulate network latency.
' Only use this for debugging purposes.
#const NETWORK_THROTTLE = false

import "pkg:/source/services/HttpCache.bs"
import "pkg:/source/utils/AssertUtils.bs"
import "pkg:/source/utils/CancellationUtils.bs"
import "pkg:/source/utils/ErrorUtils.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"
import "pkg:/source/utils/UrlUtils.bs"

' A Request holds what to send. Sending it starts a Fetch, which ends in one Response:
'
'   response = HttpClient.Get(url).Await()                ' blocks until the response
'
'   pending = HttpClient.Get(url).Send()                  ' a Fetch on a port of its own
'   response = pending.Wait(2000)                         ' the response, or invalid after 2s; the fetch goes on
'   response = pending.Poll()                             ' the response, or invalid; never blocks
'
'   pending = HttpClient.Post(url).Send()                 ' in a task loop, which blocks only on its own port
'   while true
'       message = wait(500, port)
'       response = pending.Poll()                         ' at each wake: the response once it is in, up to 500ms late
'       ...                                               ' the loop's own messages
'
' Retries run inside the fetch, on the thread that started it, while Await, Wait or Poll runs.
namespace HttpClient

    const COMPRESSION_ENABLED = true
    const DEFAULT_ATTEMPT_TIMEOUT_MS = 30000
    const DEFAULT_RETRY_DELAY_MS = 1000

    ' https://developer.roku.com/en-ca/docs/references/brightscript/events/rourlevent.md#getresponsecode-as-integer
    ' Seem to mirror the curl error codes https://curl.se/libcurl/c/libcurl-errors.html
    enum CurlErrors
        CURLE_UNSUPPORTED_PROTOCOL = -1
        CURLE_FAILED_INIT = -2
        CURLE_URL_MALFORMAT = -3
        CURLE_NOT_BUILT_IN = -4
        CURLE_COULDNT_RESOLVE_PROXY = -5
        CURLE_COULDNT_RESOLVE_HOST = -6
        CURLE_COULDNT_CONNECT = -7
        CURLE_FTP_WEIRD_SERVER_REPLY = -8
        CURLE_REMOTE_ACCESS_DENIED = -9
        CURLE_FTP_WEIRD_PASS_REPLY = -11
        CURLE_FTP_WEIRD_PASV_REPLY = -13
        CURLE_FTP_WEIRD_227_FORMAT = -14
        CURLE_FTP_CANT_GET_HOST = -15
        CURLE_HTTP2 = -16
        CURLE_FTP_COULDNT_SET_TYPE = -17
        CURLE_PARTIAL_FILE = -18
        CURLE_FTP_COULDNT_RETR_FILE = -19
        CURLE_QUOTE_ERROR = -21
        CURLE_HTTP_RETURNED_ERROR = -22
        CURLE_WRITE_ERROR = -23
        CURLE_UPLOAD_FAILED = -25
        CURLE_READ_ERROR = -26
        CURLE_OUT_OF_MEMORY = -27
        CURLE_OPERATION_TIMEDOUT = -28
        CURLE_FTP_PORT_FAILED = -30
        CURLE_FTP_COULDNT_USE_REST = -31
        CURLE_RANGE_ERROR = -33
        CURLE_HTTP_POST_ERROR = -34
        CURLE_SSL_CONNECT_ERROR = -35
        CURLE_BAD_DOWNLOAD_RESUME = -36
        CURLE_FILE_COULDNT_READ_FILE = -37
        CURLE_LDAP_CANNOT_BIND = -38
        CURLE_LDAP_SEARCH_FAILED = -39
        CURLE_FUNCTION_NOT_FOUND = -41
        CURLE_ABORTED_BY_CALLBACK = -42
        CURLE_BAD_FUNCTION_ARGUMENT = -43
        CURLE_INTERFACE_FAILED = -45
        CURLE_TOO_MANY_REDIRECTS = -47
        CURLE_UNKNOWN_TELNET_OPTION = -48
        CURLE_TELNET_OPTION_SYNTAX = -49
        CURLE_PEER_FAILED_VERIFICATION = -51
        CURLE_GOT_NOTHING = -52
        CURLE_SSL_ENGINE_NOTFOUND = -53
        CURLE_SSL_ENGINE_SETFAILED = -54
        CURLE_SEND_ERROR = -55
        CURLE_RECV_ERROR = -56
        CURLE_SSL_CERTPROBLEM = -58
        CURLE_SSL_CIPHER = -59
        CURLE_SSL_CACERT = -60
        CURLE_BAD_CONTENT_ENCODING = -61
        CURLE_LDAP_INVALID_URL = -62
        CURLE_FILESIZE_EXCEEDED = -63
        CURLE_USE_SSL_FAILED = -64
        CURLE_SEND_FAIL_REWIND = -65
        CURLE_SSL_ENGINE_INITFAILED = -66
        CURLE_LOGIN_DENIED = -67
        CURLE_TFTP_NOTFOUND = -68
        CURLE_TFTP_PERM = -69
        CURLE_REMOTE_DISK_FULL = -70
        CURLE_TFTP_ILLEGAL = -71
        CURLE_TFTP_UNKNOWNID = -72
        CURLE_REMOTE_FILE_EXISTS = -73
        CURLE_TFTP_NOSUCHUSER = -74
        CURLE_CONV_FAILED = -75
        CURLE_CONV_REQD = -76
        CURLE_SSL_CACERT_BADFILE = -77
        CURLE_REMOTE_FILE_NOT_FOUND = -78
        CURLE_SSH = -79
        CURLE_SSL_SHUTDOWN_FAILED = -80
    end enum

    function Get(url as string) as Request
        return new Request("GET", url)
    end function

    function Head(url as string) as Request
        return new Request("HEAD", url)
    end function

    function Post(url as string) as Request
        return new Request("POST", url)
    end function

    function Put(url as string) as Request
        return new Request("PUT", url)
    end function

    function Delete(url as string) as Request
        return new Request("DELETE", url)
    end function

    class Request
        ' For any method, such as a proxied request's; Get, Head, Post, Put and Delete are shorter.
        function new(method as string, url as string)
            m._method = UCase(method)
            m._url = url
            m._headers = {}
            m._attemptTimeoutMs = DEFAULT_ATTEMPT_TIMEOUT_MS
            m._retryCount = 0
            m._retryDelayMs = DEFAULT_RETRY_DELAY_MS
        end function

        function Header(key as string, value as string) as Request
            m._headers[key] = value
            return m
        end function

        function Headers(headers as object) as Request
            m._headers.Append(headers)
            return m
        end function

        function QueryParam(key as string, value as dynamic) as Request
            #if DEBUG
                Assert.IsValid(value, `QueryParam("${key}", invalid): the value can't be invalid`)
            #end if
            if m._queryParams = invalid
                m._queryParams = {}
            end if
            m._queryParams[key] = value
            m._fullUrl = invalid
            return m
        end function

        function QueryParams(queryParams as object) as Request
            if m._queryParams = invalid
                m._queryParams = {}
            end if
            m._queryParams.Append(queryParams)
            m._fullUrl = invalid
            return m
        end function

        function QueryParamArray(key as string, values as object, arrayType as UrlUtils.QueryParamArrayType) as Request
            #if DEBUG
                Assert.IsValid(values, `QueryParamArray("${key}", invalid): the values can't be invalid`)
            #end if
            return m.QueryParam(key, { value: values, arrayType: arrayType })
        end function

        ' Fills {key} in the url.
        function PathParam(key as string, value as string) as Request
            if m._pathParams = invalid
                m._pathParams = {}
            end if
            m._pathParams[key] = value
            m._fullUrl = invalid
            return m
        end function

        function PathParams(pathParams as object) as Request
            if m._pathParams = invalid
                m._pathParams = {}
            end if
            m._pathParams.Append(pathParams)
            m._fullUrl = invalid
            return m
        end function

        function TextBody(text as string) as Request
            #if DEBUG
                Assert.IsTrue(m._method <> "GET" and m._method <> "HEAD", `TextBody on a ${m._method} request: ${m._method} sends no body`)
            #end if
            m._textBody = text
            m._fileBodyPath = invalid
            return m
        end function

        function JsonBody(value as object) as Request
            #if DEBUG
                Assert.IsTrue(m._method <> "GET" and m._method <> "HEAD", `JsonBody on a ${m._method} request: ${m._method} sends no body`)
            #end if
            m._textBody = FormatJson(value)
            m._fileBodyPath = invalid
            m._headers["Content-Type"] = "application/json"
            return m
        end function

        ' fields: an AA, or an array of { key, value } where the order matters.
        function FormBody(fields as object) as Request
            #if DEBUG
                Assert.IsTrue(m._method <> "GET" and m._method <> "HEAD", `FormBody on a ${m._method} request: ${m._method} sends no body`)
            #end if
            m._textBody = UrlUtils.GetUrlEncodedForm(fields)
            m._fileBodyPath = invalid
            m._headers["Content-Type"] = "application/x-www-form-urlencoded"
            return m
        end function

        function FileBody(filePath as string) as Request
            #if DEBUG
                Assert.IsTrue(m._method <> "GET" and m._method <> "HEAD", `FileBody on a ${m._method} request: ${m._method} sends no body`)
            #end if
            m._fileBodyPath = filePath
            m._textBody = invalid
            return m
        end function

        ' How long one attempt may take, from when it is sent. The deadline is checked only when the response is
        ' waited on or polled, after the answer already in, if any: that answer is returned even if it came after the
        ' deadline, as an roUrlEvent carries no arrival time. Await and Wait time out on time; a late Poll can return
        ' a late answer, for the caller to judge whether it is too stale.
        function AttemptTimeoutMs(timeoutMs as integer) as Request
            #if DEBUG
                Assert.IsTrue(timeoutMs > 0, `AttemptTimeoutMs(${timeoutMs}): the timeout must be above 0`)
            #end if
            m._attemptTimeoutMs = timeoutMs
            return m
        end function

        ' How many more attempts may follow a failed one. A timed-out attempt is never retried: after AttemptTimeoutMs
        ' the user needs an answer, not another wait. The first attempt is retried on any failure (anything not 2xx
        ' or 3xx) except a request roUrlTransfer couldn't send, which completes at once; a later one only on a 5xx or a
        ' network failure, as a 2xx-4xx answer to a retry is final. RetryIf picks among those.
        function RetryCount(retryCount as integer) as Request
            #if DEBUG
                Assert.IsTrue(retryCount >= 0, `RetryCount(${retryCount}): the count can't be negative`)
            #end if
            m._retryCount = retryCount
            return m
        end function

        ' Each retry is sent delayMs to 2 × delayMs after the previous attempt ended.
        function RetryDelayMs(delayMs as integer) as Request
            #if DEBUG
                Assert.IsTrue(delayMs >= 0, `RetryDelayMs(${delayMs}): the delay can't be negative`)
            #end if
            m._retryDelayMs = delayMs
            return m
        end function

        ' Picks the attempts to retry instead of every failed one: predicate(response) returns the reason to retry,
        ' which the retry's warning reports, or "" or invalid not to. It sees the attempts RetryCount allows to retry,
        ' the first one's success included. A cancelled fetch never retries. A predicate that throws is logged as an
        ' error, and its attempt retries if it failed; DEBUG builds rethrow.
        function RetryIf(predicate as function) as Request
            m._retryPredicate = predicate
            return m
        end function

        ' A retried attempt, or a failure RetryIf declines to retry, is logged without a telemetry event: for requests
        ' where failing and retrying is normal.
        function NoTelemetry() as Request
            m._noTelemetry = true
            return m
        end function

        ' A successful GET is served from disk for that many seconds, instead of its Cache-Control max-age.
        function CacheForSeconds(seconds as integer) as Request
            #if DEBUG
                Assert.AreEqual("GET", m._method, `CacheForSeconds on a ${m._method} request: only GET can`)
                Assert.IsTrue(seconds > 0, `CacheForSeconds(${seconds}): the duration must be above 0`)
            #end if
            m._cacheSeconds = seconds
            return m
        end function

        ' A successful GET is served from disk for its Cache-Control max-age by default; NoCache turns that off,
        ' CacheForSeconds included.
        function NoCache() as Request
            m._noCache = true
            return m
        end function

        ' The response's body goes to filePath instead of its Text.
        function SaveBodyToFile(filePath as string) as Request
            #if DEBUG
                Assert.AreEqual("GET", m._method, `SaveBodyToFile on a ${m._method} request: only GET can`)
            #end if
            m._saveBodyToFilePath = filePath
            return m
        end function

        ' cancellation: from CancellationUtils.CreateCancellation, or invalid for none.
        function Cancellation(cancellation as dynamic) as Request
            #if DEBUG
                Assert.IsTrue(cancellation = invalid or (IsAssociativeArray(cancellation) and cancellation.node <> invalid and IsString(cancellation.field)), "Cancellation takes CancellationUtils.CreateCancellation(node, field, value), or invalid")
            #end if
            m._cancellation = cancellation
            return m
        end function

        function LogCurlCommand(enabled = true as boolean) as Request
            m._logCurlCommand = enabled
            return m
        end function

        ' The url as given, with its path params filled in and its query params appended.
        function GetFullUrl() as string
            if m._fullUrl = invalid
                m._fullUrl = UrlUtils.BuildUrl(m._url, m._pathParams, m._queryParams)
            end if
            return m._fullUrl
        end function

        function GetMethod() as string
            return m._method
        end function

        function GetHeaders() as object
            return m._headers
        end function

        ' invalid when the body is a file, or there is none.
        function GetTextBody() as dynamic
            return m._textBody
        end function

        function ToCurlCommand() as string
            command = `curl "${m.GetFullUrl()}"`
            if m._method = "HEAD"
                command += ` \\\n  --head`
            else if m._method <> "GET"
                command += ` \\\n  --request ${m._method}`
            end if
            command += ` \\\n  --max-time ${m._attemptTimeoutMs / 1000}`
            command += ` \\\n  --location \\\n  --show-error`
            if COMPRESSION_ENABLED
                command += ` \\\n  --compressed`
            end if
            for each key in m._headers
                value = m._headers[key]
                #if DEBUG
                #else
                    if LCase(key) = "authorization"
                        value = "<REDACTED>"
                    end if
                #end if
                command += ` \\\n  -H '${key}: ${value}'`
            end for
            if not StringUtils.IsNullOrEmpty(m._textBody)
                command += ` \\\n  -d '${m._textBody}'`
            end if
            if m._fileBodyPath <> invalid
                command += ` \\\n  --data-binary @${m._fileBodyPath}`
            end if
            return command
        end function

        function Await() as Response
            return m.Send().Await()
        end function

        ' Starts a fetch on a port of its own, which Await, Wait or Poll runs: a request never waited on or polled may
        ' be dropped when its task ends, and its retries never run.
        function Send() as PendingResponse
            messagePort = CreateObject("roMessagePort")
            ' Observed before the fetch starts, so a cancellation set between its check and the observation isn't missed.
            cancellationObserver = invalid
            if m._cancellation <> invalid
                cancellationObserver = CreateObject("roSGNode", "NodeObserver")
                ' Observed before the target is set: the NodeObserver's callback on the render-thread cancellation moves the
                ' NodeObserver to the render thread, after which each access to it is a rendezvous.
                cancellationObserver.ObserveField("changed", messagePort)
                cancellationObserver.target = { node: m._cancellation.node, fieldName: m._cancellation.field }
            end if
            startedFetch = new Fetch(m, messagePort)
            startedFetch.Start()
            return new PendingResponse(startedFetch, messagePort, m._cancellation, cancellationObserver)
        end function
    end class

    ' A request being sent: its attempts, timeouts, retries and cache, run by the PendingResponse that Send returns.
    ' It reads the request as it goes, so the request isn't changed after it is sent. Its port is its own: it gets
    ' only the attempts' answers and the cancellation's events.
    class Fetch
        function new(request as Request, messagePort as object)
            m._request = request
            m._messagePort = messagePort
            m._attemptCount = 0
            m._transferId = invalid
        end function

        function Start() as void
            m._clock = CreateObject("roTimespan")
            request = m._request

            if CancellationUtils.IsCancelled(request._cancellation)
                m.Cancel()
                return
            end if

            cacheable = request._method = "GET" and request._noCache <> true
            #if DISABLE_CACHE
                #if DEBUG
                    cacheable = false
                #end if
            #end if
            if cacheable
                m._cacheFilePath = HttpCache.GetFilePath(request.GetFullUrl(), request._headers, request._saveBodyToFilePath)
                cached = HttpCache.Read(m._cacheFilePath, request._saveBodyToFilePath)
                if cached <> invalid
                    m._response = m.NewResponse({
                        cached: true
                        statusCode: cached.statusCode
                        headers: cached.headers
                        text: cached.text
                        bodyFilePath: request._saveBodyToFilePath
                    })
                    LogInfo("Cache hit", request._method, request.GetFullUrl())
                    m.Throttle()
                    return
                end if
            end if
            m.StartAttempt()
        end function

        ' How long a wait on the port may last before the next HandleMessage, while the response isn't in: until the
        ' attempt's deadline while it is sent, until the retry is due between attempts. At least 1, as wait(0) has no
        ' time limit.
        function MaxWaitMs() as integer
            if m._urlTransfer <> invalid
                waitMs = m._attemptDeadlineMs - m._clock.TotalMilliseconds()
            else
                waitMs = m._retryAtMs - m._clock.TotalMilliseconds()
            end if
            if waitMs < 1
                return 1
            end if
            return waitMs
        end function

        ' message: what was taken from the port, invalid when nothing was. The deadline is checked after the message:
        ' an answer is taken even past the deadline; past it, any other message, or none, times the attempt out.
        ' Returns the response once the fetch completed, invalid until then.
        function HandleMessage(message as dynamic) as dynamic
            if m._response = invalid
                ' GetInt() is 1 when the transfer completed; an earlier attempt's transfer has another identity.
                if type(message) = "roUrlEvent" and m._urlTransfer <> invalid and message.GetInt() = 1 and message.GetSourceIdentity() = m._urlTransfer.GetIdentity()
                    m.OnAttemptEnded(m.NewResponse({ urlEvent: message, bodyFilePath: m._request._saveBodyToFilePath }))
                end if
                if m._urlTransfer <> invalid and m._clock.TotalMilliseconds() >= m._attemptDeadlineMs
                    m.OnAttemptTimeout()
                end if
                if m._response = invalid and m._urlTransfer = invalid and m._clock.TotalMilliseconds() >= m._retryAtMs
                    ' Read here too, as its event may never come.
                    if CancellationUtils.IsCancelled(m._request._cancellation)
                        m.Cancel()
                    else
                        m.StartAttempt()
                    end if
                end if
            end if
            return m._response
        end function

        ' Completes the fetch as cancelled, unless it already completed.
        function Cancel() as void
            if m._response <> invalid
                return
            end if
            if m._urlTransfer <> invalid
                m._urlTransfer.AsyncCancel()
                m._urlTransfer = invalid
            else
                ' Cancelled before an attempt was sent, or between two.
                m._transferId = invalid
            end if
            LogInfo("Cancelled", m.Describe())
            m.Complete(m.NewResponse({ cancelled: true }))
        end function

        private function StartAttempt() as void
            m._attemptCount += 1
            m._transferId = invalid
            request = m._request
            method = request._method
            urlTransfer = CreateUrlTransfer(request.GetFullUrl(), request._headers, m._messagePort)
            if urlTransfer = invalid
                LogError("Failed to create roUrlTransfer")
                m.Throttle()
                m.Complete(m.NewResponse({ notSentReason: "roUrlTransfer couldn't be created" }))
                return
            end if

            LogInfo("Sending", method, request.GetFullUrl(), "ID:", urlTransfer.GetIdentity())
            #if DEBUG
                if request._logCurlCommand <> false
                    LogDebug(`======== curl command ========\n${request.ToCurlCommand()}\n==============================`)
                end if
            #else
                if request._logCurlCommand = true
                    LogInfo(`======== curl command ========\n${request.ToCurlCommand()}\n==============================`)
                end if
            #end if

            if method = "GET"
                if request._saveBodyToFilePath <> invalid
                    sent = urlTransfer.AsyncGetToFile(request._saveBodyToFilePath)
                else
                    sent = urlTransfer.AsyncGetToString()
                end if
            else if method = "HEAD"
                sent = urlTransfer.AsyncHead()
            else
                if method <> "POST"
                    urlTransfer.SetRequest(method)
                end if
                if request._fileBodyPath <> invalid
                    sent = urlTransfer.AsyncPostFromFile(request._fileBodyPath)
                else
                    sent = urlTransfer.AsyncPostFromString(ValidString(request._textBody))
                end if
            end if

            if not sent
                LogError("Failed to send request")
                m.Throttle()
                m.Complete(m.NewResponse({ notSentReason: "roUrlTransfer refused the request" }))
                return
            end if
            m._urlTransfer = urlTransfer
            m._transferId = urlTransfer.GetIdentity()
            m._attemptDeadlineMs = m._clock.TotalMilliseconds() + request._attemptTimeoutMs
        end function

        ' A response that reads the request's cancellation when asked whether it is cancelled.
        private function NewResponse(properties as object) as Response
            properties.cancellation = m._request._cancellation
            return new Response(properties)
        end function

        private function OnAttemptTimeout() as void
            LogInfo("Timeout", m.Describe(), "after", m._request._attemptTimeoutMs, "ms")
            m._urlTransfer.AsyncCancel()
            m.OnAttemptEnded(m.NewResponse({ timedOut: true }))
        end function

        private function OnAttemptEnded(response as Response) as void
            m._urlTransfer = invalid
            m.Throttle()
            request = m._request
            ' No retry can follow: complete without reading the cancellation, a rendezvous.
            if m._attemptCount > request._retryCount or not m.MayRetry(response) or (request._retryPredicate = invalid and response.IsSuccess())
                m.Complete(response)
                return
            end if
            ' Cancelled before its event was read: neither retried nor reported.
            if response.IsCancelled()
                m.Complete(response)
                return
            end if
            retryReason = m.RetryReason(response)
            if retryReason = ""
                if not response.IsSuccess()
                    m.ReportAttempt(response.ErrorMessage(), `\nNot retrying: the retry callback declined`)
                end if
                m.Complete(response)
                return
            end if

            delayMs = request._retryDelayMs + Rnd(request._retryDelayMs + 1) - 1
            m.ReportAttempt(retryReason, `\nRetrying in ${delayMs} ms`)
            m._retryAtMs = m._clock.TotalMilliseconds() + delayMs
        end function

        ' A warning, and a telemetry event unless NoTelemetry, for an attempt that could have been retried.
        private function ReportAttempt(message as string, outcome as string) as void
            request = m._request
            LogWarnNoTelemetry(m.Describe(), "attempt", m._attemptCount, "ended:", message, outcome)
            if request._noTelemetry = true
                return
            end if
            LogTelemetryEvent({
                level: "warning"
                message: message
                attachments: [{
                    filename: "request.txt"
                    content_type: "text/plain"
                    data: request.ToCurlCommand()
                }]
            })
        end function

        ' NETWORK_THROTTLE: a cache hit, an attempt not sent, and every attempt's end come 1 to 3s late.
        private function Throttle() as void
            #if NETWORK_THROTTLE
                #if DEBUG
                    sleep(1000 + Rnd(2000))
                #end if
            #end if
        end function

        ' The attempts RetryCount allows to retry: not a timed-out one; after the first, only a 5xx or a network failure.
        private function MayRetry(response as Response) as boolean
            if response.IsTimedOut()
                return false
            end if
            if m._attemptCount = 1
                return true
            end if
            statusCode = response.StatusCode()
            return statusCode < 200 or statusCode >= 500
        end function

        ' Why to retry the attempt, "" not to: RetryIf's reason, or else the failure's error message.
        private function RetryReason(response as Response) as string
            ' Called through a local, so the predicate's m isn't the request.
            retryPredicate = m._request._retryPredicate
            if retryPredicate = invalid
                return response.ErrorMessage()
            end if
            try
                reason = retryPredicate(response)
            catch error
                #if DEBUG
                    throw error
                #else
                    LogError("RetryIf failed:", ErrorUtils.Format(error))
                    return response.ErrorMessage()
                #end if
            end try
            #if DEBUG
                Assert.IsTrue(IsString(reason) or type(reason) = "Invalid", `RetryIf returned a ${type(reason)}: it returns the reason to retry, "" or invalid not to`)
            #end if
            if not IsString(reason)
                return ""
            end if
            return reason
        end function

        ' The method and url, then the transfer ID of the attempt sent last, the RequestId of its error message: none
        ' for a cache hit, an attempt not sent, or a cancellation outside an attempt.
        private function Describe() as string
            description = `${m._request._method} ${m._request.GetFullUrl()}`
            if m._transferId <> invalid
                description += ` ID: ${m._transferId}`
            end if
            return description
        end function

        private function Complete(response as Response) as void
            m._response = response
            LogInfo("Completed", m.Describe(), response.StatusCode(), "after", m._clock.TotalMilliseconds(), "ms,", m._attemptCount, "attempt(s)")
            ' A 3xx counts as a success, but isn't cached.
            if m._cacheFilePath = invalid or response.StatusCode() < 200 or response.StatusCode() >= 300
                return
            end if
            ' A body saved to a file is in the file; an empty text body isn't cached.
            body = ""
            if response._bodyFilePath = invalid
                body = response.Text()
                if body = ""
                    return
                end if
            end if
            HttpCache.Write(m._cacheFilePath, m._request._cacheSeconds, response.StatusCode(), response.Headers(), body)
        end function
    end class

    ' A fetch on a port of its own, which Await, Wait and Poll wait on. They return the same response once it is in.
    ' Whoever sends the request takes its response or calls Cancel(): either ends the observation of its cancellation.
    class PendingResponse
        function new(startedFetch as Fetch, messagePort as object, cancellation as dynamic, cancellationObserver as dynamic)
            m._fetch = startedFetch
            m._messagePort = messagePort
            m._cancellation = cancellation
            m._cancellationObserver = cancellationObserver
            m._clock = CreateObject("roTimespan")
        end function

        function Await() as Response
            return m.WaitForResponse(-1)
        end function

        ' The response, or invalid if it isn't in within timeoutMs.
        function Wait(timeoutMs as integer) as dynamic
            #if DEBUG
                Assert.IsTrue(timeoutMs > 0, `Wait(${timeoutMs}): timeoutMs must be above 0; Poll() checks without blocking`)
            #end if
            return m.WaitForResponse(timeoutMs)
        end function

        function Poll() as dynamic
            return m.WaitForResponse(0)
        end function

        function Cancel() as void
            m._fetch.Cancel()
            m.StopObservingCancellation()
        end function

        ' timeoutMs: -1 for as long as it takes, 0 to take only what is already on the port.
        private function WaitForResponse(timeoutMs as integer) as dynamic
            m._clock.Mark()
            ' Messages already on the port go first: an answer there is taken even past the deadline.
            message = m._messagePort.GetMessage()
            while m._response = invalid
                ' The port's only node events are the cancellation observer's.
                if type(message) = "roSGNodeEvent" and CancellationUtils.IsCancelled(m._cancellation)
                    m._fetch.Cancel()
                end if
                m._response = m._fetch.HandleMessage(message)
                if m._response = invalid
                    message = m._messagePort.GetMessage()
                    if message = invalid
                        waitMs = m._fetch.MaxWaitMs()
                        if timeoutMs >= 0
                            remainingMs = timeoutMs - m._clock.TotalMilliseconds()
                            if remainingMs <= 0
                                return invalid
                            end if
                            if remainingMs < waitMs
                                waitMs = remainingMs
                            end if
                        end if
                        message = wait(waitMs, m._messagePort)
                    end if
                end if
            end while
            m.StopObservingCancellation()
            return m._response
        end function

        private function StopObservingCancellation() as void
            if m._cancellationObserver <> invalid
                m._cancellationObserver.nodeDestroy = true
                m._cancellationObserver = invalid
            end if
        end function
    end class

    class Response
        function new(properties as object)
            m._urlEvent = properties.urlEvent
            m._statusCode = properties.statusCode
            m._headers = properties.headers
            m._text = properties.text
            m._bodyFilePath = properties.bodyFilePath
            m._cached = properties.cached = true
            m._timedOut = properties.timedOut = true
            m._cancelled = properties.cancelled = true
            m._cancellation = properties.cancellation
            m._notSentReason = properties.notSentReason
        end function

        ' The HTTP status; 0 when no response came, a negative curl code when the transfer failed.
        function StatusCode() as integer
            if m._statusCode = invalid
                if m._urlEvent <> invalid
                    m._statusCode = m._urlEvent.GetResponseCode()
                else
                    m._statusCode = 0
                end if
            end if
            return m._statusCode
        end function

        ' A 2xx or 3xx status. Redirects are followed, so a 3xx is one that couldn't be.
        function IsSuccess() as boolean
            statusCode = m.StatusCode()
            return statusCode >= 200 and statusCode < 400
        end function

        function IsTimedOut() as boolean
            return m._timedOut
        end function

        ' Cancelled by its fetch, or since: the request's cancellation is read at each call, so an answer taken before
        ' a later cancel reads as cancelled too. Once it reads as cancelled it stays so, the cancellation reset or not.
        function IsCancelled() as boolean
            if not m._cancelled and CancellationUtils.IsCancelled(m._cancellation)
                m._cancelled = true
            end if
            return m._cancelled
        end function

        function IsCached() as boolean
            return m._cached
        end function

        ' Case-insensitive keys.
        function Headers() as object
            if m._headers = invalid
                if m._urlEvent <> invalid
                    m._headers = m._urlEvent.GetResponseHeaders()
                else
                    m._headers = {}
                end if
            end if
            return m._headers
        end function

        ' The Retry-After header in seconds; invalid when it is absent or an HTTP date.
        function RetryAfterSeconds() as dynamic
            retryAfter = m.Headers()["retry-after"]
            if not IsString(retryAfter)
                return invalid
            end if
            retryAfter = retryAfter.Trim()
            seconds = retryAfter.ToInt()
            if seconds < 0 or seconds.ToStr() <> retryAfter
                return invalid
            end if
            return seconds
        end function

        function Text() as string
            #if DEBUG
                Assert.IsTrue(m._bodyFilePath = invalid, `Text and Json on a SaveBodyToFile response: the body is in ${m._bodyFilePath}`)
            #end if
            if m._text = invalid
                if m._urlEvent <> invalid
                    m._text = m._urlEvent.GetString()
                else
                    m._text = ""
                end if
            end if
            return m._text
        end function

        ' The parsed body; invalid when it isn't JSON.
        function Json() as dynamic
            if m._json = invalid
                m._json = StringUtils.ParseJsonSafe(m.Text())
            end if
            return m._json
        end function

        ' Empty on success.
        function ErrorMessage() as string
            if m.IsSuccess()
                return ""
            end if
            if m._notSentReason <> invalid
                return `${Tr(Locale.HttpClient.RequestNotSent)} ${m._notSentReason}`
            end if
            if m.IsCancelled()
                return Tr(Locale.HttpClient.RequestCancelled)
            end if
            if m._timedOut
                return Tr(Locale.HttpClient.RequestTimedOut)
            end if
            ' A response built in the app, such as the built-in Invidious backend's, has no transfer to report.
            if m._urlEvent = invalid
                message = `StatusCode: ${m.StatusCode()}`
            else
                message = `${Tr(Locale.HttpClient.Reason)}:${m._urlEvent.GetFailureReason()}\nStatusCode: ${m.StatusCode()}\nRequestId: ${m._urlEvent.GetSourceIdentity()}`
            end if
            if m._bodyFilePath = invalid
                message += `\nBody: ${m.Text()}`
            end if
            return message
        end function
    end class

    function CreateUrlTransfer(url as string, headers as object, messagePort as object) as object
        urlTransfer = CreateObject("roUrlTransfer")
        if urlTransfer = invalid
            return invalid
        end if
        if COMPRESSION_ENABLED
            urlTransfer.EnableEncodings(true)
        end if
        urlTransfer.RetainBodyOnError(true)
        if LCase(Left(url, 6)) = "https:"
            urlTransfer.SetCertificatesFile("common:/certs/ca-bundle.crt")
            urlTransfer.InitClientCertificates()
        end if
        urlTransfer.SetUrl(url)
        urlTransfer.SetHeaders(headers)
        urlTransfer.SetMessagePort(messagePort)
        return urlTransfer
    end function

end namespace
