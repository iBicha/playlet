import "pkg:/source/utils/CaptionUtils.bs"

namespace Tests

    @suite
    class CaptionUtilsTests extends Rooibos.BaseTestSuite

        @describe("Caption routing and bodies")

        @it("routes Invidious auto captions through the same cleanup as local captions")
        function _()
            instance = "http://invidious.test:3000"
            source = "/api/v1/captions/n33b8s3kM5U?label=English%20%28auto-generated%29"
            track = CaptionUtils.TrackUrl({ url: source, label: "English (auto-generated)" }, instance, "invidious", 8888)
            params = UrlUtils.ParseQueryComponents(track)
            m.assertTrue(track.StartsWith("http://127.0.0.1:8888/api/captions?"))
            m.assertEqual(params.url, instance + source)
            m.assertEqual(params.auto, "1")
            local = CaptionUtils.TrackUrl({ url: "https://www.youtube.com/api/timedtext?fmt=vtt", auto_generated: true }, instance, "playlet", 8888)
            m.assertEqual(UrlUtils.ParseQueryComponents(local).auto, "1")
        end function

        @it("routes authored Invidious captions without auto cleanup")
        function _()
            source = "/api/v1/captions/XNht74Le_FA?label=English"
            track = CaptionUtils.TrackUrl({ url: source, label: "English", language_code: "en" }, "http://invidious.test:3000", "invidious", 8888)
            params = UrlUtils.ParseQueryComponents(track)
            m.assertEqual(params.url, "http://invidious.test:3000" + source)
            m.assertEqual(params.auto, "0")
            m.assertEqual(params.language, "en")
            m.assertFalse(CaptionUtils.IsAutoGenerated({ label: "English (auto-generated)", auto_generated: false }))
            m.assertFalse(CaptionUtils.IsAutoGenerated({}))
        end function

        @it("fallback preserves language and authored versus generated selection")
        function _()
            authored = { language_code: "en", auto_generated: false, url: "authored" }
            generated = { language_code: "en", auto_generated: true, url: "generated" }
            italian = { language_code: "it", auto_generated: true, url: "italian" }
            tracks = [italian, authored, generated]
            m.assertEqual(CaptionUtils.SelectFallbackTrack(tracks, "en", true).url, "generated")
            m.assertEqual(CaptionUtils.SelectFallbackTrack(tracks, "en", false).url, "authored")
            m.assertInvalid(CaptionUtils.SelectFallbackTrack(tracks, "fr", true))
            m.assertInvalid(CaptionUtils.SelectFallbackTrack(invalid, "en", true))
        end function

        @it("only accepts the configured instance's caption endpoint")
        function _()
            instance = "http://invidious.test:3000"
            m.assertTrue(CaptionUtils.IsInvidiousCaptionUrl(instance + "/api/v1/captions/n33b8s3kM5U?lang=en", instance + "/"))
            m.assertFalse(CaptionUtils.IsInvidiousCaptionUrl("http://other.test/api/v1/captions/n33b8s3kM5U", instance))
            m.assertFalse(CaptionUtils.IsInvidiousCaptionUrl(instance + "/api/v1/captions/../auth", instance))
            m.assertFalse(CaptionUtils.IsInvidiousCaptionUrl(instance + "/api/v1/captions/n33b8s3kM5U/../../auth", instance))
        end function
        @it("rejects empty VTT and HTML responses")
        function _()
            m.assertFalse(CaptionUtils.IsUsableVtt("WEBVTT"))
            m.assertFalse(CaptionUtils.IsUsableVtt("<html>blocked</html>"))
            m.assertTrue(CaptionUtils.IsUsableVtt("WEBVTT" + Chr(10) + "00:00:00.000 --> 00:00:01.000"))
        end function

        @it("removes a repeated rolling line and inline word timing")
        function _()
            nl = Chr(10)
            input = "WEBVTT" + nl + nl + "00:00:00.000 --> 00:00:01.000 align:start position:0%" + nl + "<c>Hello</c>" + nl + nl + "00:00:01.000 --> 00:00:02.000" + nl + "Hello" + nl + "<00:00:01.500><c>world</c>"
            expected = "WEBVTT" + nl + nl + "00:00:00.000 --> 00:00:01.000" + nl + "Hello" + nl + nl + "00:00:01.000 --> 00:00:02.000" + nl + "world"
            m.assertEqual(CaptionUtils.NormalizeAutoVtt(input), expected)
        end function

        @it("skips tiny duplicate cues but preserves repeated speech")
        function _()
            m.assertTrue(CaptionUtils.IsShortCue("00:00:01.000 --> 00:00:01.010"))
            m.assertFalse(CaptionUtils.IsShortCue("00:00:01.000 --> 00:00:02.000"))
            nl = Chr(10)
            input = "WEBVTT" + nl + nl + "00:00:00.000 --> 00:00:01.000" + nl + "Hello" + nl + nl + "00:00:01.000 --> 00:00:02.000" + nl + "Hello"
            m.assertEqual(CaptionUtils.NormalizeAutoVtt(input), input)
        end function

    end class

end namespace
