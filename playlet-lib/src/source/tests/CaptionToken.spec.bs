import "pkg:/components/Services/Innertube/PlayerEndpoint.bs"

namespace Tests

    @suite
    class CaptionTokenTests extends Rooibos.BaseTestSuite

        @describe("Caption proof requirements")

        @it("requires caption proof only for enforced tracks without a token")
        function _()
            m.assertTrue(Innertube.RequiresCaptionPoToken({ exp: "xpe" }))
            m.assertTrue(Innertube.RequiresCaptionPoToken({ exp: "other,xpv" }))
            m.assertTrue(Innertube.RequiresCaptionPoToken({ exp: "xpe", pot: "" }))
            m.assertFalse(Innertube.RequiresCaptionPoToken({}))
            m.assertFalse(Innertube.RequiresCaptionPoToken({ exp: "xpextra" }))
            m.assertFalse(Innertube.RequiresCaptionPoToken({ exp: "xpe", pot: "existing" }))
        end function

    end class

end namespace
