import "pkg:/components/Services/Invidious/InvidiousService.bs"

namespace Tests

    @suite
    class InvidiousAuthErrorTests extends Rooibos.BaseTestSuite

        function Token() as string
            return FormatJson({ "session": "v1:test", "signature": "test", "scopes": [":subscriptions*"] })
        end function

        @describe("Invidious.ShouldMarkNeedsReauth")

        @it("recognizes expired and invalid credentials")
        function _()
            errors = [
                "Request must be authenticated"
                "Invalid signature"
                "Erroneous token"
                "Token is expired, please try again"
            ]
            for each error in errors
                m.assertTrue(Invidious.ShouldMarkNeedsReauth(m.Token(), 403, FormatJson({ error: error })), error)
            end for
        end function

        @it("does not invalidate a profile on downstream failures")
        function _()
            errors = [
                "Deleted or invalid channel"
                "Unable to fetch channel"
                "Database unavailable"
                "Arithmetic overflow"
                "Invalid scope"
            ]
            for each error in errors
                m.assertFalse(Invidious.ShouldMarkNeedsReauth(m.Token(), 403, FormatJson({ error: error })), error)
            end for
        end function

        @it("does not invalidate a profile on unrelated responses")
        function _()
            m.assertFalse(Invidious.ShouldMarkNeedsReauth(m.Token(), 200, "[]"))
            m.assertFalse(Invidious.ShouldMarkNeedsReauth(m.Token(), 0, ""))
            m.assertFalse(Invidious.ShouldMarkNeedsReauth(m.Token(), 500, FormatJson({ error: "Invalid signature" })))
            m.assertFalse(Invidious.ShouldMarkNeedsReauth(m.Token(), 403, "<html>blocked</html>"))
            m.assertFalse(Invidious.ShouldMarkNeedsReauth(m.Token(), 403, "{}"))
        end function

        @it("handles malformed credentials without matching parser error text")
        function _()
            m.assertTrue(Invidious.ShouldMarkNeedsReauth("{", 403, FormatJson({ error: "unexpected token '<EOF>'" })))
            m.assertTrue(Invidious.ShouldMarkNeedsReauth("{}", 403, FormatJson({ error: "Missing hash key: session" })))
            m.assertTrue(Invidious.ShouldMarkNeedsReauth(FormatJson({ "session": "v1:test", "scopes": [] }), 403, FormatJson({ error: "Missing hash key: signature" })))
            m.assertTrue(Invidious.ShouldMarkNeedsReauth(m.Token(), 401, FormatJson({ error: "Unauthorized" })))
        end function

    end class

end namespace
