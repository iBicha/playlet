import "pkg:/components/Services/Innertube/OAuth.bs"

namespace Tests

    @suite
    class InnertubeOAuthTerminalErrorTests extends Rooibos.BaseTestSuite

        @describe("Innertube.IsTerminalRefreshError")

        @it("Returns true for terminal OAuth error codes (RFC 6749 §5.2)")
        function _()
            m.assertTrue(Innertube.IsTerminalRefreshError({ error: "invalid_grant" }))
            m.assertTrue(Innertube.IsTerminalRefreshError({ error: "invalid_client" }))
            m.assertTrue(Innertube.IsTerminalRefreshError({ error: "unauthorized_client" }))
        end function

        @it("Returns false for transient, successful, or non-object bodies")
        function _()
            m.assertFalse(Innertube.IsTerminalRefreshError({ error: "authorization_pending" }))
            m.assertFalse(Innertube.IsTerminalRefreshError({ access_token: "ya29.abc" }))
            m.assertFalse(Innertube.IsTerminalRefreshError({}))
            m.assertFalse(Innertube.IsTerminalRefreshError(invalid))
        end function

        @describe("Innertube.RefreshRetryReason")

        @it("Retries a failed refresh with its error, unless the token endpoint rejected the credential or the client")
        function _()
            transient = new HttpClient.Response({ statusCode: 503, text: `{"error":"backend_error"}` })
            m.assertEqual(Innertube.RefreshRetryReason(transient), transient.ErrorMessage())
            m.assertNotEqual(transient.ErrorMessage(), "")
            m.assertEqual(Innertube.RefreshRetryReason(new HttpClient.Response({ statusCode: 400, text: `{"error":"invalid_grant"}` })), "")
            m.assertEqual(Innertube.RefreshRetryReason(new HttpClient.Response({ statusCode: 401, text: `{"error":"invalid_client"}` })), "")
            m.assertEqual(Innertube.RefreshRetryReason(new HttpClient.Response({ statusCode: 200, text: `{"access_token":"ya29.abc"}` })), "")
        end function

    end class

end namespace
