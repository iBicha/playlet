import "pkg:/components/Services/LoungeService/LoungeApi.bs"
import "pkg:/source/tests/LoggingGlobals.bs"
import "pkg:/source/utils/RegistryUtils.bs"
import "pkg:/source/utils/StringUtils.bs"

namespace Tests

    @tags("integration")
    @suite
    class LoungeRefreshTokenIntegrationTests extends Rooibos.BaseTestSuite

        protected override function setup()
            m.logLevel = Tests.MuteLogger()
            ' Rebind saves the test lounge as the last one, which the next app launch disconnects from.
            m.lastLoungeData = RegistryUtils.Read(RegistryUtils.LAST_LOUNGE_DATA)
        end function

        protected override function tearDown()
            m.global.logger.logLevel = m.logLevel
            if m.lastLoungeData = invalid
                RegistryUtils.Delete(RegistryUtils.LAST_LOUNGE_DATA)
            else
                RegistryUtils.Write(RegistryUtils.LAST_LOUNGE_DATA, m.lastLoungeData)
            end if
        end function

        @describe("Lounge token-refresh recovery (live)")

        @slow(30000)
        @it("RefreshToken re-mints a lounge token that successfully rebinds a session")
        function _()
            api = m.CreateLiveApi()

            screenId = api.GetScreenId()
            m.assertFalse(StringUtils.IsNullOrEmpty(screenId), "failed to mint a screen id")

            firstToken = api.GetToken()
            m.assertFalse(StringUtils.IsNullOrEmpty(firstToken), "failed to mint a lounge token")

            m.assertTrue(api.GetSessionData(), "initial bind failed")
            m.assertFalse(StringUtils.IsNullOrEmpty(api.sessionId), "no sessionId after initial bind")
            m.assertFalse(StringUtils.IsNullOrEmpty(api.gSessionId), "no gSessionId after initial bind")

            refreshedToken = api.RefreshToken()
            m.assertFalse(StringUtils.IsNullOrEmpty(refreshedToken), "RefreshToken returned no token")
            m.assertEqual(api.loungeToken, refreshedToken, "RefreshToken did not update the api token")

            m.assertTrue(api.GetSessionData(), "rebind after refresh failed")
            m.assertFalse(StringUtils.IsNullOrEmpty(api.sessionId), "no sessionId after rebind")
            m.assertFalse(StringUtils.IsNullOrEmpty(api.gSessionId), "no gSessionId after rebind")
        end function

        @slow(30000)
        @it("sends the messages a bind calls for, and reports each one's status once it completes")
        function _()
            api = m.CreateLiveApi()
            api.GetScreenId()
            api.GetToken()
            m.assertTrue(api.GetSessionData(), "bind failed")

            results = []
            timer = CreateObject("roTimespan")
            while results.Count() = 0 and timer.TotalMilliseconds() < 10000
                results.Append(api.ProcessPendingOutgoingMessages())
                sleep(50)
            end while
            m.assertNotEmpty(results, "no outgoing message completed")
            for each result in results
                m.assertEqual(result.status, 200, result.error)
            end for
        end function

        @slow(30000)
        @it("Rebind cancels the replaced session's sends, and the new session's sends complete")
        function _()
            api = m.CreateLiveApi()
            api.GetScreenId()
            api.GetToken()
            m.assertTrue(api.GetSessionData(), "bind failed")
            m.assertTrue(api.HasPendingOutgoingMessages(), "the bind sent no messages")
            replacedSends = []
            replacedSends.Append(api.pendingOutgoingMessages)

            m.assertTrue(api.Rebind(true), "rebind failed")

            m.assertNotEmpty(replacedSends)
            for each pending in replacedSends
                m.assertTrue(pending.Poll().IsCancelled(), "a send of the replaced session was not cancelled")
            end for

            results = []
            timer = CreateObject("roTimespan")
            while api.HasPendingOutgoingMessages() and timer.TotalMilliseconds() < 10000
                results.Append(api.ProcessPendingOutgoingMessages())
                sleep(50)
            end while
            m.assertFalse(api.HasPendingOutgoingMessages(), "the new session's sends did not complete")
            m.assertNotEmpty(results, "the rebind sent no messages")
            for each result in results
                m.assertEqual(result.status, 200, result.error)
            end for
        end function

        private function CreateLiveApi() as object
            loungeServiceNode = CreateObject("roSGNode", "Node")
            loungeServiceNode.addFields({
                deviceId: CreateObject("roDeviceInfo").GetRandomUUID()
                deviceName: "Playlet integration test"
            })
            ' getNowPlaying, received on bind, reads nav state off the queue.
            queueStub = CreateObject("roSGNode", "Node")
            queueStub.addFields({ hasPrevious: false, hasNext: false })
            notifyStub = CreateObject("roSGNode", "Node")
            return new LoungeApi(loungeServiceNode, queueStub, notifyStub, invalid)
        end function

    end class

end namespace
