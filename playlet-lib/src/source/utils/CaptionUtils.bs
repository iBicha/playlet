import "pkg:/source/utils/UrlUtils.bs"

namespace CaptionUtils

    function IsAutoGenerated(caption as object) as boolean
        if IsBool(caption.auto_generated)
            return caption.auto_generated
        end if
        if IsBool(caption.autoGenerated)
            return caption.autoGenerated
        end if
        if not IsString(caption.label)
            return false
        end if
        return LCase(caption.label).InStr("auto-generated") >= 0
    end function

    function IsInvidiousCaptionUrl(url as string, instance as string) as boolean
        if instance.EndsWith("/")
            instance = instance.Left(instance.Len() - 1)
        end if
        prefix = instance + "/api/v1/captions/"
        if instance = "" or not url.StartsWith(prefix)
            return false
        end if
        suffix = url.Mid(prefix.Len())
        if suffix.InStr("#") >= 0
            return false
        end if
        videoId = suffix.Split(Chr(63))[0]
        return CreateObject("roRegex", "^[A-Za-z0-9_-]{11}$", "").IsMatch(videoId)
    end function

    function TrackUrl(caption as object, instance as string, backend as string, port as integer) as string
        if instance.EndsWith("/")
            instance = instance.Left(instance.Len() - 1)
        end if
        url = caption.url
        if not url.StartsWith("http")
            url = instance + url
        end if
        autoGenerated = IsAutoGenerated(caption)
        shouldProxy = backend = "playlet" and UrlUtils.ParseQueryComponents(url)["fmt"] = "vtt"
        if backend = "invidious" and IsInvidiousCaptionUrl(url, instance)
            shouldProxy = true
        end if
        if not shouldProxy
            return url
        end if
        autoFlag = "0"
        if autoGenerated
            autoFlag = "1"
        end if
        return UrlUtils.BuildUrl(`http://127.0.0.1:${port}/api/captions`, invalid, { url: url, auto: autoFlag, language: ValidString(caption.language_code) })
    end function

    function SelectFallbackTrack(captions as dynamic, language as string, autoGenerated as boolean) as dynamic
        if not IsArray(captions) or language = ""
            return invalid
        end if
        for each caption in captions
            if caption.language_code = language and IsAutoGenerated(caption) = autoGenerated
                return caption
            end if
        end for
        return invalid
    end function

    function IsUsableVtt(body as string) as boolean
        return body.StartsWith("WEBVTT") and body.InStr(" --> ") >= 0
    end function

    ' Remove YouTube's rolling previous line, keeping normally repeated speech.
    function NormalizeAutoVtt(body as string) as string
        blocks = body.Replace(Chr(13), "").Split(Chr(10) + Chr(10))
        result = []
        state = { previousLine: "" }
        timestamp = CreateObject("roRegex", "<\d{2}:\d{2}:\d{2}\.\d{3}>", "")
        classTag = CreateObject("roRegex", "</?c[^>]*>", "")
        timingSettings = CreateObject("roRegex", "(\d{2}:\d{2}:\d{2}\.\d{3} --> \d{2}:\d{2}:\d{2}\.\d{3}).*", "")
        for each block in blocks
            cue = NormalizeAutoCue(block, state, timestamp, classTag, timingSettings)
            if cue <> invalid
                result.Push(cue)
            end if
        end for
        return result.Join(Chr(10) + Chr(10))
    end function

    function NormalizeAutoCue(block as string, state as object, timestamp as object, classTag as object, timingSettings as object) as dynamic
        lines = block.Split(Chr(10))
        timingIndex = -1
        for i = 0 to lines.Count() - 1
            if lines[i].InStr(" --> ") >= 0
                timingIndex = i
                exit for
            end if
        end for
        if timingIndex < 0
            return block
        end if
        textLines = []
        for i = timingIndex + 1 to lines.Count() - 1
            line = classTag.ReplaceAll(timestamp.ReplaceAll(lines[i], ""), "").Trim()
            if line <> ""
                textLines.Push(line)
            end if
        end for
        if textLines.Count() = 0
            return invalid
        end if
        if textLines[0] = state.previousLine
            if textLines.Count() > 1
                textLines.Shift()
            else if IsShortCue(lines[timingIndex])
                return invalid
            end if
        end if
        state.previousLine = textLines[textLines.Count() - 1]
        cue = []
        for i = 0 to timingIndex - 1
            cue.Push(lines[i])
        end for
        cue.Push(timingSettings.ReplaceAll(lines[timingIndex], "\1"))
        cue.Append(textLines)
        return cue.Join(Chr(10))
    end function

    function IsShortCue(timing as string) as boolean
        regex = CreateObject("roRegex", "(\d{2}):(\d{2}):(\d{2})\.(\d{3})", "")
        times = regex.MatchAll(timing)
        if times.Count() <> 2
            return false
        end if
        values = []
        for each parts in times
            values.Push(((parts[1].ToInt() * 60 + parts[2].ToInt()) * 60 + parts[3].ToInt()) * 1000 + parts[4].ToInt())
        end for
        duration = values[1] - values[0]
        return duration >= 0 and duration <= 100
    end function

end namespace
