<component name="StatsForNerds" extends="Group" includes="Disposable">
    <!-- Passive fullscreen diagnostics for the wired Video node. The coordinator owns `visible` (the per-video
         toggle, fullscreen, and a settled PiP restore); this only reads the node. Rows are built in Init from
         one table (StatsForNerds.bs), so each value label is addressable by name (e.g. #resolutionValue). -->
    <interface>
        <field id="video" type="node" />
    </interface>
    <children>
        <!-- Below the title block (up to 3 title lines + the author end near y=190) and above the button row. -->
        <Rectangle id="background" width="420" translation="[68, 200]" color="0x000000" opacity="0.75">
            <LayoutGroup id="rows" layoutDirection="vert" itemSpacings="[6]" translation="[12, 12]" />
        </Rectangle>
    </children>
</component>
