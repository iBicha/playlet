' https://developer.roku.com/docs/developer/media-playback/voice-controls/transport-controls.md
enum TransportCommand
    Play = "play"
    Pause = "pause"
    stop = "stop"
    Ok = "ok"
    Forward = "forward"
    Rewind = "rewind"
    Replay = "replay"
    StartOver = "startover"
    Seek = "seek"
    next = "next"
    Skip = "skip"
    NowPlaying = "nowplaying"
    Like = "like"
    Dislike = "dislike"
    Shuffle = "shuffle"
    Loop = "loop"
end enum

enum TransportSeekDirection
    Forward = "forward"
    Backward = "backward"
end enum

' https://developer.roku.com/docs/references/brightscript/interfaces/ifinput.md#eventresponseroassociativearray-aa-as-boolean
enum TransportStatus
    Success = "success"
    SuccessSeekStart = "success.seek-start"
    SuccessSeekEnd = "success.seek-end"
    Unhandled = "unhandled"
    Error = "error"
    ErrorGeneric = "error.generic"
    ErrorAd = "error.ad"
    ErrorChannel = "error.channel"
    ErrorLive = "error.live"
    ErrorNoMedia = "error.no-media"
    ErrorRedundant = "error.redundant"
end enum
