import "pkg:/components/Services/Innertube/Context.bs"
import "pkg:/source/services/HttpClient.bs"

namespace Innertube
    function CreateResolveUrlRequest(url as string) as HttpClient.Request
        deviceInfo = CreateObject("roDeviceInfo")

        payload = {
            "context": CreateContext(ClientType.Web, deviceInfo)
            "url": url
        }

        request = HttpClient.Post("https://www.youtube.com/youtubei/v1/navigation/resolve_url?prettyPrint=false&alt=json").JsonBody(payload)
        request.Headers(Innertube.CreateHeaders(ClientType.Web))

        return request
    end function
end namespace
