' Segments fromSeqnum up to the next run's fromSeqnum, each durationMs long, the first
' starting at startMs on the live timeline. A run starts at or after the previous one's end.
interface LiveDurationRun
    fromSeqnum as integer
    startMs as integer
    durationMs as integer
end interface

' A live head check: seqnum -1 and timeMs invalid when the response lacks them.
interface LiveHeadReading
    seqnum as integer
    timeMs as dynamic
    response as object
end interface
