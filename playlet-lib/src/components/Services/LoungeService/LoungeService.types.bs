enum LoungeCloseReason
    Complete = "complete"
    Empty = "empty"
    Stalled = "stalled"
    Timeout = "timeout"
    NotSent = "not_sent"
    Curl = "curl"
    Http = "http"
end enum

enum LoungeSessionStep
    Poll = "poll"
    Retry = "retry"
    Rebind = "rebind"
    RebindWithNewToken = "rebind_with_new_token"
    Drop = "drop"
end enum

interface LoungeCommand
    index as integer
    type as string
    args as dynamic
end interface
