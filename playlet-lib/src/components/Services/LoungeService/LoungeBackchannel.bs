import "pkg:/components/Services/LoungeService/LoungeService.types.bs"
import "pkg:/source/services/HttpClient.bs"
import "pkg:/source/utils/ByteArrayUtils.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"

' The server answers a poll with a noop after at most ~30 s idle, and drops a session that goes 55-60 s without a poll.
' Giving up on a dead connection by 40 s lets the next poll, after the first backoff, land before the session is gone.
const LOUNGE_POLL_TIMEOUT_MS = 40000

class LoungeBackchannel

    public statusCode = 0
    public closeReason as LoungeCloseReason
    public ackedCommandIndex = -1
    public stalledPolls = 0
    public pollTimeoutMs = LOUNGE_POLL_TIMEOUT_MS

    private pending = invalid
    private polledCommandIndex = -1

    ' A new session restarts command indices from 0.
    function StartSession(bindResponseText as string) as LoungeCommand[]
        m.ackedCommandIndex = -1
        m.stalledPolls = 0
        return m.Receive(m.ExtractFrames(bindResponseText))
    end function

    function Open(request as HttpClient.Request, messagePort as object) as void
        m.statusCode = 0
        m.closeReason = invalid
        m.polledCommandIndex = m.ackedCommandIndex
        m.pending = request.QueryParam("AID", m.ackedCommandIndex).NoCache().RetryCount(0).AttemptTimeoutMs(m.pollTimeoutMs).SendOn(messagePort)
    end function

    function Close() as void
        if m.pending <> invalid
            m.pending.Cancel()
            m.pending = invalid
        end if
    end function

    function IsPolling() as boolean
        return m.pending <> invalid
    end function

    function MaxWaitMs() as integer
        if m.pending = invalid
            return 0
        end if
        return m.pending.MaxWaitMs()
    end function

    function Handle(message as dynamic) as LoungeCommand[]
        if m.pending = invalid
            return []
        end if
        response = m.pending.Handle(message)
        if response = invalid
            return []
        end if
        m.pending = invalid
        m.statusCode = response.StatusCode()

        if response.IsTimedOut()
            m.closeReason = LoungeCloseReason.Timeout
            return []
        end if
        if m.statusCode = 0
            m.closeReason = LoungeCloseReason.NotSent
            return []
        end if
        if m.statusCode < 200 or m.statusCode >= 300
            m.closeReason = LoungeCloseReason.Http
            return []
        end if

        frames = m.ExtractFrames(response.Text())
        if frames.Count() = 0
            m.closeReason = LoungeCloseReason.Empty
            return []
        end if
        commands = m.Receive(frames)
        ' Nothing acknowledged: the next poll is answered with the same frames.
        if m.ackedCommandIndex = m.polledCommandIndex
            m.closeReason = LoungeCloseReason.Stalled
            m.stalledPolls += 1
        else
            m.closeReason = LoungeCloseReason.Complete
            m.stalledPolls = 0
        end if
        return commands
    end function

    ' Frame = `<byteLength>\n<json>`, the length counted in BYTES. The answer is complete, so a malformed or cut-off
    ' frame ends the extraction: no later read can complete it.
    private function ExtractFrames(text as string) as object
        body = CreateObject("roByteArray")
        body.FromAsciiString(text)
        frames = []
        count = body.Count()
        cursor = 0
        while cursor < count
            if body[cursor] = 10 or body[cursor] = 13
                cursor += 1
                continue while
            end if
            frameStart = cursor
            frameLength = 0
            ' Stops once the length exceeds the body: a frame that long can't be whole, and the integer can't overflow.
            while cursor < count and body[cursor] >= 48 and body[cursor] <= 57 and frameLength <= count
                frameLength = frameLength * 10 + body[cursor] - 48
                cursor += 1
            end while
            if cursor < count and body[cursor] = 13
                cursor += 1
            end if
            if cursor >= count or body[cursor] <> 10 or frameLength = 0 or count - cursor - 1 < frameLength
                LogTelemetryEvent({
                    level: "warning"
                    message: `Lounge answer has a malformed or cut-off frame at byte ${frameStart} of ${count}: ${text}`
                    fingerprint: "lounge-partial-frame"
                })
                exit while
            end if
            dataStart = cursor + 1
            frames.Push(ByteArrayUtils.Slice(body, dataStart, dataStart + frameLength).ToAsciiString())
            cursor = dataStart + frameLength
        end while
        return frames
    end function

    private function Receive(frames as object) as LoungeCommand[]
        commands = []
        for each frame in frames
            entries = StringUtils.ParseJsonSafe(frame)
            if not IsArray(entries)
                LogTelemetryEvent({
                    level: "error"
                    message: "Lounge frame did not parse to a command array: " + frame.Left(256)
                    fingerprint: "lounge-unparseable-frame"
                })
                continue for
            end if

            for each entry in entries
                if not IsArray(entry) or entry.Count() = 0 or not IsInt(entry[0])
                    m.LogMalformedCommand(entry)
                    continue for
                end if
                index = entry[0]
                if index <= m.ackedCommandIndex
                    LogDebug("Skipping command already received:", entry)
                    continue for
                end if
                ' Acknowledged before validation: the server answers an unacknowledged command again, at once.
                m.ackedCommandIndex = index

                data = entry[1]
                if not IsArray(data) or data.Count() = 0 or not IsString(data[0])
                    m.LogMalformedCommand(entry)
                    continue for
                end if
                commands.Push({ index: index, type: data[0], args: data[1] })
            end for
        end for
        return commands
    end function

    private function LogMalformedCommand(entry as dynamic) as void
        LogTelemetryEvent({
            level: "error"
            message: "Malformed lounge command: " + FormatJson(entry).Left(256)
            fingerprint: "lounge-malformed-command"
        })
    end function

end class
