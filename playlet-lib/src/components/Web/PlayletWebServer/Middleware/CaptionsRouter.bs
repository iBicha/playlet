import "pkg:/components/Services/Innertube/Constants.bs"
import "pkg:/components/Services/Invidious/InvidiousService.bs"
import "pkg:/components/Services/Innertube/InnertubeService.bs"
import "pkg:/components/Web/WebServer/Http/HttpRouter.bs"
import "pkg:/source/services/HttpClient.bs"
import "pkg:/source/utils/CaptionUtils.bs"

namespace Http

    class CaptionsRouter extends HttpRouter

        function new(server as object)
            super()
            m.invidious = new Invidious.InvidiousService(server.sceneNodes.invidious)
            m.innertube = server.sceneNodes.innertube
        end function

        @get("/api/captions")
        function GetCaptions(context as object) as boolean
            url = context.request.query.url
            response = context.response
            ' Only YouTube timedtext or the configured instance's caption API.
            if not IsString(url)
                response.Default(400, "Invalid caption URL")
                return true
            end if
            allowed = url.StartsWith("https://www.youtube.com/api/timedtext?")
            if not allowed
                allowed = CaptionUtils.IsInvidiousCaptionUrl(url, m.invidious.GetInvidiousInstance())
            end if
            if not allowed
                response.Default(400, "Invalid caption URL")
                return true
            end if
            request = HttpClient.Get(url)
            request.Header("User-Agent", VIDEO_PLAYER_USER_AGENT).TimeoutSeconds(15).LogCurlCommand(false)
            upstream = request.Await()
            body = upstream.Text()
            if upstream.IsSuccess() and not CaptionUtils.IsUsableVtt(body) and CaptionUtils.IsInvidiousCaptionUrl(url, m.invidious.GetInvidiousInstance())
                body = m.FetchDirectCaptions(url, ValidString(context.request.query.language), context.request.query.auto = "1")
            end if
            if not upstream.IsSuccess() or not CaptionUtils.IsUsableVtt(body)
                response.Default(502, "No usable captions available")
                return true
            end if
            if context.request.query.auto = "1"
                body = CaptionUtils.NormalizeAutoVtt(body)
            end if
            response.http_code = 200
            response.ContentType("text/vtt; charset=UTF-8")
            response.headers["Cache-Control"] = "private, max-age=300"
            response.SetBodyDataString(body)
            return true
        end function

        function FetchDirectCaptions(url as string, language as string, autoGenerated as boolean) as string
            videoId = url.Split("/api/v1/captions/")[1].Split(Chr(63))[0]
            if language = ""
                language = ValidString(UrlUtils.ParseQueryComponents(url).lang)
            end if
            if language = ""
                return ""
            end if
            visitorData = ""
            if IsAssociativeArray(m.innertube.sessionData)
                visitorData = ValidString(m.innertube.sessionData.visitorData)
            end if
            metadata = InnertubeService.GetVideoMetadata(videoId, { fetchNext: false, visitorData: visitorData })
            track = CaptionUtils.SelectFallbackTrack(metadata.captions, language, autoGenerated)
            if track = invalid or not track.url.StartsWith("https://www.youtube.com/api/timedtext?")
                return ""
            end if
            request = HttpClient.Get(track.url)
            request.Header("User-Agent", VIDEO_PLAYER_USER_AGENT).TimeoutSeconds(15).LogCurlCommand(false)
            result = request.Await()
            if result.IsSuccess()
                return result.Text()
            end if
            return ""
        end function

    end class

end namespace
