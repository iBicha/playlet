<component name="PollInTask" extends="Task">
    <interface>
        <field id="url" type="string" />
        <!-- owned by the thread that made it, so cancelling it reaches this task from another thread -->
        <field id="cancellationNode" type="node" />
        <field id="sending" type="boolean" />
        <field id="cancelled" type="boolean" />
    </interface>
</component>
