<component name="NodeObserver" extends="Node">
    <interface>
        <!-- { node, fieldName }: the field to observe. -->
        <field id="target" type="assocarray" />
        <!-- Set to true on the field's first change; the field is no longer observed after that. -->
        <field id="changed" type="boolean" />
        <!-- Set by the creator when done: stops observing. Dropped while observing on a task thread, the observer stays
             registered on the field even after the task ends. -->
        <field id="nodeDestroy" type="boolean" />
    </interface>
</component>
