import "pkg:/source/PlayletLibUrls.bs"

namespace Registry

    function ReadKey(key as string, section as string) as dynamic
        sec = CreateObject("roRegistrySection", section)
        if not sec.Exists(key)
            return invalid
        end if
        return sec.Read(key)
    end function

    function DeleteKey(key as string, section as string)
        sec = CreateObject("roRegistrySection", section)
        sec.Delete(key)
        sec.Flush()
    end function

    function DeleteAll()
        reg = CreateObject("roRegistry")
        sectionNames = reg.GetSectionList()
        for each sectionName in sectionNames
            reg.Delete(sectionName)
        end for
        reg.Flush()
    end function

    function GetPlayletLibUrlsFromRegistry() as object
        urlsJson = ReadKey("playlet_lib_urls", "Playlet")
        if urlsJson = invalid
            return invalid
        end if
        ' bs:disable-next-line NO_PARSE_JSON
        urls = ParseJson(urlsJson)
        return urls
    end function

    function ClearPlayletLibUrlsIfNeeded(launchArgs as object) as void
        if launchArgs = invalid or launchArgs.clearPlayletLibUrls = invalid
            return
        end if
        DeleteKey("playlet_lib_urls", "Playlet")
        Logger.Log("Cleared key playlet_lib_urls from registry")
    end function

    ' BootstrapScene's load-failure fallback never reaches a pinned lib that loads and then
    ' crashes, so the device stays on it across every channel update.
    function ClearUnsupportedPlayletLibUrls() as void
        urls = GetPlayletLibUrlsFromRegistry()
        if urls = invalid
            return
        end if

        for each entry in urls
            if PlayletLibUrls.IsUnsupported(entry)
                DeleteKey("playlet_lib_urls", "Playlet")
                Logger.Log(`Cleared key playlet_lib_urls from registry: ${entry.link} is no longer supported`)
                return
            end if
        end for
    end function

    function ClearRegistryIfNeeded(launchArgs as object) as void
        if launchArgs = invalid or launchArgs.clearRegistry = invalid
            return
        end if
        DeleteAll()
        Logger.Log("Cleared all data from registry")
    end function

end namespace
